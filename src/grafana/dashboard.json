                        "rawQuery": true,
                        "rawSql": "SELECT \r\n    p.product_name AS \"Product\",\r\n    p.categories AS \"Category\",\r\n    i.quantity AS \"Quantity\",\r\n    expiration_date AS \"Expiration Date\",\r\n    (expiration_date - CURRENT_DATE) AS \"Days Left\"\r\nFROM inventory i\r\ninner join products p on p.product_id = i.product_id\r\nWHERE expiration_date != '2099-12-31'\r\nORDER BY \"Days Left\" ASC;",
